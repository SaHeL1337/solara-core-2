generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id
  flux            Int      @default(500)
  lastUpdate      DateTime @default(now()) // Used for lazy resource calculation
  displayName     String?
  playerClass     String?
  isSetupComplete Boolean  @default(false)
  isDefeated      Boolean  @default(false)
  planets         Planet[]
  fleetMovements  FleetMovement[]
  receivedMessages Message[] @relation("ReceivedMessages")
  scanReports     ScanReport[]
  tags            Tag[]
  templates       PlanetTemplate[]
}



enum SpaceObjectType {
  PLANET
  ASTEROID
  BLACK_HOLE
}

model SpaceObject {
  id          String          @id @default(uuid())
  type        SpaceObjectType
  name        String
  titanium    Int             @default(500)
  silicate    Int             @default(500)
  isotope     Int             @default(500)
  x           Int             @default(0)
  y           Int             @default(0)
  updatedAt   DateTime        @default(now())

  planet      Planet?
  
  outgoingFleets FleetMovement[] @relation("OriginSpaceObject")
  incomingFleets FleetMovement[] @relation("TargetSpaceObject")

  @@index([x, y])
}

model Planet {
  id          String            @id
  spaceObject SpaceObject       @relation(fields: [id], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id])
  buildings   PlanetBuilding[]
  queue       BuildingQueue[]
  ships       PlanetShip[]
  shipQueue   ShipQueue[]

  population  Int @default(0)
  populationCapacity Int @default(0)
  storageCapacity Int @default(10000)
  sovereignty Int @default(100)
  sovereigntyUpdatedAt DateTime @default(now())
  
  scanReports     ScanReport[]
  tags            Tag[] @relation("PlanetTags")
}

enum MissionType {
  ATTACK
  MINE
  EXPLORE
  SCAN
  SUPPORT
  CONQUER
}

enum FleetMovementStatus {
  EN_ROUTE
  RETURNING
  COMPLETED
}

model FleetMovement {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  
  originId          String?
  origin            SpaceObject?         @relation("OriginSpaceObject", fields: [originId], references: [id], onDelete: SetNull)
  
  targetId          String?
  target            SpaceObject?         @relation("TargetSpaceObject", fields: [targetId], references: [id], onDelete: SetNull)
  targetX           Int?
  targetY           Int?
  
  missionType       MissionType
  status            FleetMovementStatus @default(EN_ROUTE)
  
  startTime         DateTime            @default(now())
  arrivalTime       DateTime
  returnArrivalTime DateTime?
  
  ships             FleetShip[]
  resources         FleetResource[]
}

model FleetShip {
  id              String        @id @default(uuid())
  fleetMovementId String
  fleetMovement   FleetMovement @relation(fields: [fleetMovementId], references: [id], onDelete: Cascade)
  type            String
  count           Int
}

model FleetResource {
  id              String        @id @default(uuid())
  fleetMovementId String
  fleetMovement   FleetMovement @relation(fields: [fleetMovementId], references: [id], onDelete: Cascade)
  type            String        // TITANIUM, SILICATE, ISOTOPE
  amount          Int
}

model PlanetShip {
  id          String   @id @default(uuid())
  planetId    String
  planet      Planet   @relation(fields: [planetId], references: [id])
  type        String
  count       Int      @default(0)

  @@unique([planetId, type])
}

model ShipQueue {
  id             String      @id @default(uuid())
  planetId       String
  planet         Planet      @relation(fields: [planetId], references: [id])
  shipType       String
  quantity       Int
  status         QueueStatus @default(PENDING)
  costTitanium   Int
  costSilicate   Int
  costIsotope    Int
  durationSec    Int         // duration per 1 ship
  position       Int        
  startedAt      DateTime?   // when the current *individual* ship started building
  completedCount Int         @default(0)
}

model PlanetBuilding {
  id          String   @id @default(uuid())
  planetId    String
  planet      Planet   @relation(fields: [planetId], references: [id])
  type        String   // e.g., "GOLD_MINE", "WOOD_MILL" from config
  level       Int      @default(0)

  @@unique([planetId, type])
}

model BuildingQueue {
  id           String      @id @default(uuid())
  planetId     String
  planet       Planet      @relation(fields: [planetId], references: [id])
  buildingType String
  targetLevel  Int
  status       QueueStatus @default(PENDING)
  costFlux     Int
  costTitanium Int
  costSilicate Int
  costIsotope  Int
  durationSec  Int
  position     Int        
  startedAt    DateTime?
  finishedAt   DateTime
}

enum QueueStatus {
  PENDING
  BUILDING
  COMPLETED
}

model Message {
  id          String   @id @default(uuid())
  senderId    String   // "0" for system
  recipientId String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  title       String
  body        String   // Can contain JSON or formatted text
  isRead      Boolean  @default(false)
  category    MessageCategory @default(SYSTEM)
  tags        String[] // e.g., ["mining", "attack", "explore", "system"]
  createdAt   DateTime @default(now())

  @@index([recipientId, isRead])
}

enum MessageCategory {
  SYSTEM
  PLAYER
  MINING
  ATTACK
  EXPLORE
  REPORT
  CONQUEST
}

model ScanReport {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planetId  String
  planet    Planet   @relation(fields: [planetId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())

  @@unique([userId, planetId])
}

model Tag {
  id         String   @id @default(uuid())
  name       String
  color      String   @default("#00E5FF")
  properties Json     @default("{}")
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planets    Planet[] @relation("PlanetTags")
  template   PlanetTemplate?

  @@unique([userId, name])
}

model PlanetTemplate {
  id        String   @id @default(uuid())
  name      String
  buildings Json     // string[]
  ships     Json     // Record<string, number>
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId     String?  @unique
  tag       Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
}