generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  flux          Int    @default(500)
  lastUpdate    DateTime @default(now()) // Used for lazy resource calculation
  planets       Planet[]
}

enum SpaceObjectType {
  PLANET
  ASTEROID
  BLACK_HOLE
}

model SpaceObject {
  id          String          @id @default(uuid())
  type        SpaceObjectType
  name        String
  titanium    Int             @default(500)
  silicate    Int             @default(500)
  isotope     Int             @default(500)
  x           Int             @default(0)
  y           Int             @default(0)
  updatedAt   DateTime        @default(now())

  planet      Planet?

  @@index([x, y])
}

model Planet {
  id          String            @id
  spaceObject SpaceObject       @relation(fields: [id], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id])
  buildings   PlanetBuilding[]
  queue       BuildingQueue[]
}

model PlanetBuilding {
  id          String   @id @default(uuid())
  planetId    String
  planet      Planet   @relation(fields: [planetId], references: [id])
  type        String   // e.g., "GOLD_MINE", "WOOD_MILL" from config
  level       Int      @default(0)

  @@unique([planetId, type])
}

model BuildingQueue {
  id           String      @id @default(uuid())
  planetId     String
  planet       Planet      @relation(fields: [planetId], references: [id])
  buildingType String
  targetLevel  Int
  status       QueueStatus @default(PENDING)
  costFlux     Int
  costTitanium Int
  costSilicate Int
  costIsotope  Int
  durationSec  Int
  position     Int        
  startedAt    DateTime?
  finishedAt   DateTime
}

enum QueueStatus {
  PENDING
  BUILDING
  COMPLETED
}