generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  flux          Int    @default(500)
  lastUpdate    DateTime @default(now()) // Used for lazy resource calculation
  planets       Planet[]
}

model Planet {
  id          String            @id @default(uuid())
  ownerId     String
  titanium        Int    @default(500)
  silicate         Int    @default(500)
  isotope         Int    @default(500)
  owner       User              @relation(fields: [ownerId], references: [id])
  name        String
  buildings   PlanetBuilding[]
  queue       BuildingQueue[]
}

model PlanetBuilding {
  id          String   @id @default(uuid())
  planetId    String
  planet      Planet   @relation(fields: [planetId], references: [id])
  type        String   // e.g., "GOLD_MINE", "WOOD_MILL" from config
  level       Int      @default(0)

  @@unique([planetId, type])
}

model BuildingQueue {
  id           String      @id @default(uuid())
  planetId     String
  planet       Planet      @relation(fields: [planetId], references: [id])
  buildingType String
  targetLevel  Int
  status       QueueStatus @default(PENDING)
  costFlux     Int
  costTitanium Int
  costSilicate Int
  costIsotope  Int
  durationSec  Int
  position     Int         // 0, 1, or 2 for your 3-slot limit
  startedAt    DateTime?
}

enum QueueStatus {
  PENDING
  BUILDING
  COMPLETED
}